# ------------------------------------------------------------------
# VJ_DOC — server environment
# Copy this file to `.env` and adjust the values for your machine.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB. Local dev default; swap for an Atlas SRV string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/vj_doc

# Public origin of the React app (used for CORS + share links).
CLIENT_URL=http://localhost:5173

# Secrets — ALWAYS replace these in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-another-long-random-string

# Storage driver: `local` (filesystem) | `s3` (S3-compatible object storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# S3-compatible object storage (used when STORAGE_DRIVER=s3).
# Point S3_ENDPOINT at MinIO / a local emulator and keep S3_FORCE_PATH_STYLE=true there.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Uploads
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_REQUEST=30

# How long temporary processing artefacts live before the cleaner removes them.
FILE_TTL_HOURS=24

# In-process job queue workers (how many documents process at once).
QUEUE_CONCURRENCY=2

# Optional — point VJ_DOC at a locally installed LibreOffice for Office
# conversions. Leave empty to auto-detect (e.g. C:\Program Files\LibreOffice\program\soffice.com).
LIBREOFFICE_PATH=

# AI workspace. AI summary / Ask PDF need an OpenAI-compatible provider.
# AI_BASE_URL is optional (defaults to OpenAI). Never sent to the client.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
