# ------------------------------------------------------------------
# VJ_DOC — server environment
# Copy this file to `.env` and adjust the values for your machine.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB. Local dev default; swap for an Atlas SRV string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/vj_doc

# Public origin of the React app (used for CORS + share links).
CLIENT_URL=http://localhost:5173

# Secrets — ALWAYS replace these in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-another-long-random-string

# Storage driver: `local` (filesystem) | `s3` (S3-compatible, not wired yet)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# Uploads
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_REQUEST=30

# How long temporary processing artefacts live before the cleaner removes them.
FILE_TTL_HOURS=24

# Optional — reserved for the AI workspace (Phase 5). Never sent to the client.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
